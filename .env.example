# =====================
# LLM
# =====================
PROVIDER_API_KEY=
PROVIDER_BASE_URL=
LLM_MODEL=gpt-5.6-luna
LLM_TEMPERATURE=0
LLM_MAX_RETRY=3
LLM_TIMEOUT_SECONDS=60

# =====================
# Database
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=30000

# =====================
# Environment
# =====================
AGENT_ROLE=analyst
ALLOW_PII_ACCESS=false
MAX_QUERY_ROWS=1000
MAX_RESULT_BYTES=5000000
MAX_SQL_LENGTH=50000
MAX_QUERY_COST=100000
MAX_ESTIMATED_ROWS=1000000
ALLOWED_TABLES=

SERVICE_NAME=sql-agent
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/sql_agent.log
ENABLE_CONSOLE_LOG=true
ENABLE_FILE_LOG=true
JSON_LOGGING=true

MAX_REPAIR_ATTEMPTS=2
MIN_REPAIR_CONFIDENCE=0.70

BENCHMARK_DATASET_PATH=benchmark_questions.csv
BENCHMARK_REPORT_PATH=reports/evaluation.json
